# Flask Application Configuration
FLASK_APP=app.py
FLASK_ENV=development
FLASK_DEBUG=True
SECRET_KEY=replace-with-a-secure-random-secret-key-in-production
PORT=5000
HOST=127.0.0.1
LOG_LEVEL=INFO

# File Upload & Security Safeguards
MAX_CONTENT_LENGTH_MB=50
ALLOWED_EXTENSIONS=csv

# DoS & Resource Exhaustion Protection Limits
MAX_ROWS_LIMIT=1000000
MAX_COLUMNS_LIMIT=500
MAX_QUERY_LENGTH=5000

# File Retention & Automated Pruning (in hours)
FILE_RETENTION_HOURS=24

# Storage Paths (relative to project root or absolute paths)
UPLOAD_FOLDER=data/uploads
PROCESSED_FOLDER=data/processed
REPORTS_FOLDER=data/reports
TEMP_FOLDER=data/temp

# AI / LLM Configuration
# Supported Providers: gemini, openai, anthropic, deterministic_fallback
AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
LLM_MODEL=gemini-1.5-pro
